{
    "app-id": "io.github.omafellas.omamusic",
    "runtime": "org.gnome.Platform",
    "runtime-version": "48",
    "sdk": "org.gnome.Sdk",
    "command": "omamusic",
    "cleanup": [
        "/cargo",
        "/include",
        "/lib/debug",
        "/lib/pkgconfig",
        "/share/pkgconfig"
    ],
    "modules": [
        {
            "name": "omamusic",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --locked",
                "install -Dm755 target/release/omamusic /app/bin/omamusic",
                "install -Dm644 flatpak/io.github.omafellas.omamusic.desktop /app/share/applications/io.github.omafellas.omamusic.desktop",
                "install -Dm644 flatpak/io.github.omafellas.omamusic.svg /app/share/icons/hicolor/scalable/apps/io.github.omafellas.omamusic.svg",
                "install -Dm644 flatpak/io.github.omafellas.omamusic.metainfo.xml /app/share/metainfo/io.github.omafellas.omamusic.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".build/src"
                }
            ]
        }
    ],
    "finish-args": [
        "--device=dri",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--own-name=org.mpris.MediaPlayer2.omamusic",
        "--own-name=org.kde.StatusNotifierItem-*",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.freedesktop.Notifications",
        "--filesystem=xdg-music:ro",
        "--filesystem=~/.local/state/omarchy:ro",
        "--share=network"
    ]
}
